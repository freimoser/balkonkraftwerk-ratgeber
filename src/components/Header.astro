---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const base = import.meta.env.BASE_URL;

const links = [
  { href: '/', label: 'Startseite' },
  { href: '/blog', label: 'Ratgeber' },
  { href: '/ueber-mich', label: 'Über mich' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '' || pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={base} class="logo" aria-label="SolarBalkon Ratgeber – Startseite">
      <span class="logo__icon" aria-hidden="true">☀</span>
      <span>SolarBalkon</span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Menü öffnen"
      id="nav-toggle"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Hauptnavigation">
      <ul>
        {links.map((link) => (
          <li>
            <a
              href={base === '/' ? link.href : base.replace(/\/$/, '') + link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.setAttribute('aria-label', open ? 'Menü öffnen' : 'Menü schließen');
      nav.classList.toggle('is-open', !open);
    });
  }
</script>
