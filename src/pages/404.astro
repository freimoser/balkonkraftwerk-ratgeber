---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout
  title="Seite nicht gefunden"
  description="Die angeforderte Seite existiert nicht."
  noindex={true}
>
  <section class="section">
    <div class="container text-center">
      <h1>404 – Seite nicht gefunden</h1>
      <p style="color: var(--color-text-muted); max-width: 28rem; margin-inline: auto;">
        Diese Seite gibt es nicht (mehr). Nutzen Sie die Navigation oder kehren Sie zur Startseite zurück.
      </p>
      <p class="mt-xl">
        <a class="btn btn--secondary" href={base}>Zur Startseite</a>
        <a class="btn btn--primary" href={base + "blog"} style="margin-left: 0.75rem;">Zum Ratgeber</a>
      </p>
    </div>
  </section>
</BaseLayout>
